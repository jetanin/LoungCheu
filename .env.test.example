# Copy to root .env.test. Keep credentials private.
# Disposable test database only. Suites delete/reset fixtures; NEVER use live data.
# Can share a local PostgreSQL instance with the app, but not its database.
TEST_DATABASE_URL=postgresql://postgres:REPLACE_LOCALLY@localhost:5432/loungcheu_test
# Playwright overrides (E2E_PASSWORD/E2E_WEB_PORT/E2E_API_PORT) are process
# environment variables: export them in your shell, not in this dotenv file.
