# Server runtime configuration. Test credentials belong in root .env.test.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=<schema_name>"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=http://127.0.0.1:5173
PORT=3000
NODE_ENV=development
SESSION_COOKIE_SECURE=false
APP_VERSION=local
# Set DEMO_SEED_PASSWORD privately in server/.env before db:seed/test:local-db.
