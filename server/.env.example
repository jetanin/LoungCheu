# Copy to server/.env for local use. Never commit the filled file.
# npm workspace commands run from server/, where dotenv reads this file.
# App database (NOT loungcheu_test). Encode reserved characters in credentials.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=<schema_name>"
# Private random value, at least 32 characters. Keep stable across releases.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Browser origin only, no path or trailing slash. Cloud: actual HTTPS service origin.
APP_ORIGIN=http://127.0.0.1:5173
# Cloud Run PORT and configured container port must agree.
PORT=3000
# Cloud: production (binds 0.0.0.0 and serves client/dist).
NODE_ENV=development
# Cloud: true. Production rejects HTTP origins or insecure cookies.
SESSION_COOKIE_SECURE=false
# Cloud: full SHA of the deployed main release; not the feature branch SHA.
APP_VERSION=local
# Seed/local auth smoke only: set privately before db:seed/test:local-db.
# No default password. Reseeding can update existing demo account passwords/roles.
# DEMO_SEED_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_PASSWORD
