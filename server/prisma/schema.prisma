generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  passwordHash String  @map("password_hash")
  displayName  String  @map("display_name")
  role         Role
  isActive     Boolean @default(true) @map("is_active")

  @@map("users")
}
