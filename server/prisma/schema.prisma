generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

// Shared schema foundation from SDS v0.5; accounts/events logic belongs to #1/#2.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique
  password_hash String
  display_name  String
  role          Role
  is_active     Boolean        @default(true)
  events        Event[]
  registrations Registration[]
}

model Event {
  id                     String         @id @default(uuid()) @db.Uuid
  organizer_id           String         @db.Uuid
  title                  String
  description            String
  location               String
  starts_at              DateTime       @db.Timestamptz(3)
  ends_at                DateTime       @db.Timestamptz(3)
  registration_closes_at DateTime       @db.Timestamptz(3)
  capacity               Int
  status                 EventStatus    @default(DRAFT)
  created_at             DateTime       @default(now()) @db.Timestamptz(3)
  updated_at             DateTime       @updatedAt @db.Timestamptz(3)
  organizer              User           @relation(fields: [organizer_id], references: [id], onDelete: Restrict)
  registrations          Registration[]

  @@index([status, starts_at])
  @@index([organizer_id])
}

model Registration {
  id             String             @id @default(uuid()) @db.Uuid
  event_id       String             @db.Uuid
  participant_id String             @db.Uuid
  status         RegistrationStatus @default(ACTIVE)
  registered_at  DateTime           @db.Timestamptz(3)
  event          Event              @relation(fields: [event_id], references: [id], onDelete: Restrict)
  participant    User               @relation(fields: [participant_id], references: [id], onDelete: Restrict)

  @@unique([event_id, participant_id])
  @@index([participant_id, registered_at])
  @@index([event_id, status])
}
