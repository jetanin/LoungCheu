generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  passwordHash String  @map("password_hash")
  displayName  String  @map("display_name")
  role         Role
  isActive     Boolean @default(true) @map("is_active")
  events       Event[]
  registrations Registration[]

  @@map("users")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationStatus {
  ACTIVE
  CANCELLED
}

// Minimal shared Event foundation required by F-03. Event APIs remain owned by #2.
model Event {
  id                   String      @id @default(uuid()) @db.Uuid
  organizerId          String      @map("organizer_id") @db.Uuid
  title                String
  description          String
  location             String
  startsAt             DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime    @map("ends_at") @db.Timestamptz(3)
  registrationClosesAt DateTime    @map("registration_closes_at") @db.Timestamptz(3)
  capacity             Int
  status               EventStatus @default(DRAFT)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizer            User        @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  registrations        Registration[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@map("events")
}

model Registration {
  id            String             @id @default(uuid()) @db.Uuid
  eventId       String             @map("event_id") @db.Uuid
  participantId String             @map("participant_id") @db.Uuid
  status        RegistrationStatus @default(ACTIVE)
  registeredAt  DateTime           @map("registered_at") @db.Timestamptz(3)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participant   User               @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([eventId, participantId])
  @@index([participantId, registeredAt])
  @@index([eventId, status])
  @@map("registrations")
}
