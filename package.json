{
  "name": "loungcheu", "version": "0.1.0", "private": true,
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev -w client",
    "preview": "npm run preview -w client",
    "generate": "npm run generate -w server",
    "build": "npm run build --workspaces",
    "test": "vitest run --exclude '**/integration/**'",
    "test:db": "vitest run server/tests/integration",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": { "vitest": "5.1.0", "typescript": "5.9.3" }
}
