# Copy to .env.docker, fill privately, and use --env-file .env.docker.
# Use random hexadecimal strings for DB password (URL-safe) and session secret.
# Changing a DB password here does not change an already-initialized DB volume.
DOCKER_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DOCKER_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DOCKER_DEMO_PASSWORD=REPLACE_WITH_PRIVATE_DEMO_PASSWORD
DOCKER_WEB_PORT=5173
DOCKER_API_PORT=3000
APP_VERSION=local-docker
